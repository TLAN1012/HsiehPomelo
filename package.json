{
  "name": "hsieh-pomelo",
  "version": "1.0.0",
  "private": true,
  "description": "謝家老欉紅文旦 訂購網站（Cloudflare Pages + D1）",
  "scripts": {
    "dev": "wrangler pages dev --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply hsieh-pomelo --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply hsieh-pomelo --remote",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
